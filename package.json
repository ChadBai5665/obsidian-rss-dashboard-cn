{
  "name": "rss-dashboard-cn",
  "version": "0.1.0",
  "description": "Chinese-first RSS, website, YouTube, podcast, and optional X dashboard for Obsidian",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "check:css-scope": "node scripts/check-css-scope.js",
    "check:platform": "node scripts/check-platform-compat.mjs",
    "check:important": "node scripts/check-css-important.mjs",
    "check:compliance": "npm run check:css-scope && npm run check:platform && npm run check:important && npm run check:commit-message",
    "check:commit-message": "node scripts/check-commit-message.mjs",
    "check:public": "node scripts/check-public-repo.mjs",
    "check:version": "node scripts/check-version-consistency.mjs",
    "build": "npm run check:compliance && npm run lint && tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "audit:i18n": "node scripts/audit-i18n.mjs",
    "check": "npm run test:unit && npm run audit:i18n && npm run check:public && npm run check:version && npm run check:compliance && npm run lint && npm run build",
    "lint": "eslint . --max-warnings=0",
    "lint:dev": "eslint .",
    "test:unit": "vitest run --config vitest.config.mjs",
    "fixtures:tikhub": "node scripts/capture-tikhub-fixtures.mjs",
    "hooks:install": "node scripts/setup-git-hooks.mjs",
    "prepare": "npm run hooks:install",
    "release:stage": "npm run build && node scripts/check-release-artifacts.mjs --stage",
    "release:check": "node scripts/check-release-artifacts.mjs --check",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [],
  "author": "ChadBai",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "overrides": {
    "brace-expansion@<=1.1.15": "1.1.16",
    "brace-expansion@>=2.0.0 <2.1.2": "2.1.2",
    "brace-expansion@>=3.0.0 <5.0.7": "5.0.7",
    "fast-uri@>=3.0.0 <=3.1.3": "3.1.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@typescript-eslint/parser": "^8.60.1",
    "@typescript-eslint/utils": "^8.51.0",
    "@vitest/coverage-v8": "4.1.2",
    "esbuild": "0.27.7",
    "eslint": "^9.39.2",
    "eslint-plugin-obsidianmd": "^0.1.9",
    "globals": "^16.5.0",
    "moment": "^2.30.1",
    "obsidian": "1.8.7",
    "postcss": "^8.5.6",
    "postcss-selector-parser": "^7.1.0",
    "prettier": "^3.8.1",
    "tslib": "2.4.0",
    "typescript": "^5.9.3",
    "vitest": "4.1.2"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "jsdom": "^28.1.0",
    "turndown": "^7.2.0",
    "yaml": "^2.9.0"
  }
}
